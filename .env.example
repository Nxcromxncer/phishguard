# Copy to .env (which is git-ignored) and edit. Load with:
#   set -a; . ./.env; set +a
# No real secrets belong in this example file.

# --- Input limits ---
PHISHGUARD_MAX_URL_LENGTH=2048
PHISHGUARD_MAX_BODY_BYTES=8192

# --- Abuse protection ---
PHISHGUARD_RATE_LIMIT_PER_MINUTE=60

# --- CORS (leave empty: the extension does not need it) ---
PHISHGUARD_CORS_ORIGINS=

# --- Provisional rule thresholds (0-100); tuned in Phase 5 ---
PHISHGUARD_SUSPICIOUS_THRESHOLD=30
PHISHGUARD_HIGH_RISK_THRESHOLD=60

# --- ML model (Phase 3) ---
# Directory with model.joblib + model_meta.json. Empty = backend/models.
PHISHGUARD_MODEL_DIR=
# Pin the expected SHA-256 of model.joblib (64 lowercase hex characters, printed in
# model_meta.json after training). Keep this OUTSIDE the model directory: it is what
# makes a swapped model file detectable. Empty = only the in-metadata check is done.
PHISHGUARD_MODEL_SHA256=
# DEMO ONLY: set to 1 to allow a model trained on synthetic data. Never in real use.
PHISHGUARD_ALLOW_SYNTHETIC_MODEL=

# --- Logging ---
PHISHGUARD_LOG_LEVEL=INFO

# Phase 4 will add the threat-intelligence API key variable here.
