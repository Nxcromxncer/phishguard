{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "0.2.0",
  "description": "Manual phishing-URL risk assessment using a local PhishGuard backend. Gives an assessment, not a guarantee.",
  "action": {
    "default_title": "PhishGuard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
